{
  "name": "atelie-alexandra",
  "private": true,
  "workspaces": [
    "frontend/*",
    "packages/*"
  ],
  "scripts": {
    "dev:dashboard": "npm run dev -w @atelie/dashboard",
    "dev:landing": "npm run dev -w @atelie/landing",
    "build": "npm run build -w @atelie/dashboard && npm run build -w @atelie/landing",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --test packages/studio/tests/*.test.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  }
}
